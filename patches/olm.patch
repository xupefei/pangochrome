diff --git a/websocket/redact.go b/websocket/redact.go
new file mode 100644
index 0000000000000000000000000000000000000000..888d0de252b0de841039def5d4b91b620e03d11b
--- /dev/null
+++ b/websocket/redact.go
@@ -0,0 +1,25 @@
+package websocket
+
+import "strings"
+
+// redactForLog returns a copy of message data for debug logs, with the
+// values of secret fields replaced. Ping and register messages carry the
+// user token, and helper.log is not a place for it.
+func redactForLog(data any) any {
+	m, ok := data.(map[string]any)
+	if !ok {
+		return data
+	}
+	out := make(map[string]any, len(m))
+	for k, v := range m {
+		key := strings.ToLower(k)
+		switch {
+		case strings.Contains(key, "token"), strings.Contains(key, "secret"),
+			strings.Contains(key, "password"), strings.Contains(key, "privatekey"):
+			out[k] = "(hidden)"
+		default:
+			out[k] = redactForLog(v)
+		}
+	}
+	return out
+}
diff --git a/websocket/redact_test.go b/websocket/redact_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..9407576653a00f1fcc417986f7f0e27e661905a9
--- /dev/null
+++ b/websocket/redact_test.go
@@ -0,0 +1,30 @@
+package websocket
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestRedactForLog(t *testing.T) {
+	data := map[string]any{
+		"userToken": "tok-123",
+		"olmId":     "olm1",
+		"publicKey": "pub",
+		"nested":    map[string]any{"secret": "s-456"},
+	}
+	got := fmt.Sprintf("%+v", redactForLog(data))
+	for _, leak := range []string{"tok-123", "s-456"} {
+		if strings.Contains(got, leak) {
+			t.Errorf("log text %q contains %q", got, leak)
+		}
+	}
+	for _, keep := range []string{"olm1", "pub"} {
+		if !strings.Contains(got, keep) {
+			t.Errorf("log text %q lost %q", got, keep)
+		}
+	}
+	if data["userToken"] != "tok-123" {
+		t.Error("redactForLog changed the message itself")
+	}
+}
