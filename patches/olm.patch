index 0000000000000000000000000000000000000000..60e4bf0d0a9f2e33788bf9913aa50f8f1224ff9c
--- /dev/null
+++ b/olm/privatekey_test.go
@@ -0,0 +1,31 @@
+package olm
+
+import (
+	"testing"
+
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+)
+
+func TestTunnelPrivateKey(t *testing.T) {
+	want, err := wgtypes.GeneratePrivateKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, err := tunnelPrivateKey(want.String())
+	if err != nil || got != want {
+		t.Fatalf("tunnelPrivateKey(configured) = %v, %v; want the configured key", got, err)
+	}
+
+	a, err := tunnelPrivateKey("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, _ := tunnelPrivateKey("")
+	if a == (wgtypes.Key{}) || a == b {
+		t.Fatal("an empty PrivateKey should give a new random key each time")
+	}
+
+	if _, err := tunnelPrivateKey("not a key"); err == nil {
+		t.Fatal("accepted an invalid key")
+	}
+}
